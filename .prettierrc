{
  "endOfLine": "lf",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": "*.md",
      "options": { "embeddedLanguageFormatting": "off" }
    }
  ]
}
