{
  "name": "react-elegant-toasts",
  "version": "0.1.2",
  "type": "module",
  "description": "A highly customizable toast notification component for React",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "cp src/styles.css dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.test.json && tsc -p tsconfig.tooling.json",
    "typecheck:demo": "tsc -p demo/tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build",
    "demo": "vite",
    "build:demo": "vite build"
  },
  "keywords": [
    "react",
    "toast",
    "notification",
    "alert",
    "popup",
    "message",
    "ui",
    "component",
    "typescript",
    "react-component",
    "notifications",
    "toast-notifications"
  ],
  "author": {
    "name": "Peter Ahlgren",
    "url": "https://github.com/ahlgren1234"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^3.2.7",
    "vitest-axe": "1.0.0-pre.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahlgren1234/react-elegant-toasts.git"
  },
  "bugs": {
    "url": "https://github.com/ahlgren1234/react-elegant-toasts/issues"
  },
  "homepage": "https://ahlgren1234.github.io/react-elegant-toasts/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
