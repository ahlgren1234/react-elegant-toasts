{
  "name": "react-elegant-toasts",
  "version": "0.1.2",
  "type": "module",
  "description": "A highly customizable toast notification component for React",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup",
    "build:css": "cp src/styles.css dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test --grep-invert @evidence",
    "test:browser:evidence": "playwright test --grep @evidence",
    "browser:serve": "vite build --config browser/vite.config.ts && vite preview --config browser/vite.config.ts",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.test.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.browser.json",
    "typecheck:demo": "npm run build && tsc -p demo/tsconfig.json",
    "lint": "npm run build && eslint . --max-warnings 0 && node scripts/check-styles.js",
    "lint:fix": "npm run build && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:package": "npm run build && node scripts/validate-package.js",
    "size": "size-limit",
    "prepublishOnly": "npm run build",
    "demo": "npm run build && vite",
    "build:demo": "npm run build && vite build"
  },
  "keywords": [
    "react",
    "toast",
    "notification",
    "alert",
    "popup",
    "message",
    "ui",
    "component",
    "typescript",
    "react-component",
    "notifications",
    "toast-notifications"
  ],
  "author": {
    "name": "Peter Anyawantana",
    "url": "https://github.com/ahlgren1234"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "14.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.7",
    "vitest-axe": "1.0.0-pre.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahlgren1234/react-elegant-toasts.git"
  },
  "bugs": {
    "url": "https://github.com/ahlgren1234/react-elegant-toasts/issues"
  },
  "homepage": "https://ahlgren1234.github.io/react-elegant-toasts/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
